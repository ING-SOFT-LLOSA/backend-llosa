package com.llosa.backend.seguridad.combination;

import com.llosa.backend.config.TestData;
import com.llosa.backend.seguridad.entity.Usuario;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.security.core.context.SecurityContextHolder;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.securityContext;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

/**
 * CP08: Verificar que al desactivar un usuario se invaliden sus tokens JWT
 * y se cierren sus sesiones
 *
 * STRATEGY COMBINADO:
 * LAYER 1: Unit logic - verificar estado del usuario sin sesiones
 * LAYER 2: Integration - verificar cambio en BD y efecto en endpoints
 * LAYER 3: E2E - validar flujo completo: acceso → desactivación → rechazo
 */
class CP08CombinationTest extends CombinationTestBase {

	@BeforeEach
	void setUp() {
		limpiarDatos();
		SecurityContextHolder.clearContext();
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 1: Unit Logic - Verificar lógica sin transacciones
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp08_layer1_unitLogic_usuarioDesactivoDebeRechazarAcceso() {
		// Escenario unitario: verificar que un usuario con activo=false
		// no debería permitir acceso lógico

		// ARRANGE
		Usuario usuarioActivo = TestData.usuario();
		usuarioActivo.setActivo(true);

		Usuario usuarioInactivo = TestData.usuario();
		usuarioInactivo.setActivo(false);
		usuarioInactivo.setFirebaseUuid("uid-inactivo");

		// ACT & ASSERT
		assertThat(usuarioActivo.getActivo()).isTrue();
		assertThat(usuarioInactivo.getActivo()).isFalse();

		// La lógica debería rechazar al usuario inactivo
		assertThat(usuarioInactivo.getActivo()).isFalse();
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 2: Integration - Verificar cambio en BD y efectos en servicios
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp08_layer2_integration_desactivacionPersistenEnBD() {
		// Escenario de integración: verificar que la desactivación persiste
		// en PostgreSQL y afecta las consultas

		// ARRANGE: Crear usuario activo en BD
		final String email = "empleado@llosaedificaciones.com";
		Usuario usuario = crearUsuarioConRolEnBD(email, "Juan Pérez", "CLIENTE", true);
		Integer usuarioId = usuario.getId();

		// VERIFY INITIAL
		Usuario reloaded = usuarioRepository.findById(usuarioId).orElseThrow();
		assertThat(reloaded.getActivo()).isTrue();

		// ACT: Desactivar usuario (simular cambio en BD)
		reloaded.setActivo(false);
		usuarioRepository.save(reloaded);

		// ASSERT: Verificar que el cambio persiste
		Usuario desactivado = usuarioRepository.findById(usuarioId).orElseThrow();
		assertThat(desactivado.getActivo()).isFalse();

		// Verificar que findByEmail también devuelve el usuario desactivado
		Usuario byEmail = usuarioRepository.findByEmail(email).orElseThrow();
		assertThat(byEmail.getActivo()).isFalse();
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3: E2E - Validar flujo completo: acceso activo → desactivación → rechazo
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp08_layer3_e2e_flujoDesactivacionCierraAcceso() throws Exception {
		// Escenario E2E: Usuario activo puede acceder → se desactiva → es rechazado

		final String firebaseUid = "cp08-empleado-uid";
		final String email = "exempleado@llosaedificaciones.com";

		// SETUP: Crear usuario activo en BD
		Usuario usuario = crearUsuarioConRolEnBD(email, "Ex Empleado", "ASESOR", true);
		usuario.setFirebaseUuid(firebaseUid);
		usuarioRepository.save(usuario);

		// STEP 1: Verificar acceso con usuario activo → debe funcionar
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.email").value(email))
				.andExpect(jsonPath("$.activo").value(true));

		// STEP 2: Desactivar usuario vía DELETE /api/users/{id}
		executeWithFirebaseMock(firebaseUid, () -> {
			mockMvc.perform(delete("/api/users/{id}", usuario.getId())
					.with(securityContext(contextWithAuth(createAdminToken())))
					.with(csrf()))
					.andExpect(status().isOk());
			return null;
		});

		// Verificar en BD que usuario está inactivo
		Usuario usuarioDesactivado = usuarioRepository.findById(usuario.getId()).orElseThrow();
		assertThat(usuarioDesactivado.getActivo()).isFalse();

		// STEP 3: Intentar acceder con token del usuario desactivado → debe ser rechazado (403)
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isForbidden())
				.andExpect(jsonPath("$.error").value("Cuenta suspendida. Contacte a la inmobiliaria."));
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3 VARIANT: E2E - Acceso a endpoints protegidos rechazado para inactivos
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp08_layer3_e2e_usuarioInactivoRechazadoEnTodosEndpoints() throws Exception {
		// Escenario E2E: Usuario desactivado no puede acceder a ningún endpoint protegido

		final String firebaseUid = "cp08-brecha-uid";
		final String email = "brecha@llosaedificaciones.com";

		// SETUP: Crear usuario y desactivarlo directamente en BD
		Usuario usuario = crearUsuarioConRolEnBD(email, "Usuario Brecha", "ASESOR", false);
		usuario.setFirebaseUuid(firebaseUid);
		usuarioRepository.save(usuario);

		// ACT & ASSERT: Intentar acceder a /api/auth/me → rechazado
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isForbidden());

		// ACT & ASSERT: Intentar acceder a /api/roles → rechazado
		mockMvc.perform(get("/api/roles")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isForbidden());

		// ACT & ASSERT: Intentar acceder a /api/users → rechazado
		mockMvc.perform(get("/api/users")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isForbidden());
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3 VARIANT: E2E - Reactivación permite acceso nuevamente
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp08_layer3_e2e_reactivacionRestablecerAcceso() throws Exception {
		// Escenario E2E: Usuario desactivado → reactivado → acceso restablecido

		final String firebaseUid = "cp08-reactivar-uid";
		final String email = "reactivado@llosaedificaciones.com";

		// SETUP: Crear usuario activo
		Usuario usuario = crearUsuarioConRolEnBD(email, "Usuario Reactivado", "CLIENTE", true);
		usuario.setFirebaseUuid(firebaseUid);
		usuarioRepository.save(usuario);

		// STEP 1: Desactivar
		Usuario desactivado = usuarioRepository.findById(usuario.getId()).orElseThrow();
		desactivado.setActivo(false);
		usuarioRepository.save(desactivado);

		// Verificar que acceso es rechazado
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isForbidden());

		// STEP 2: Reactivar
		Usuario reactivado = usuarioRepository.findById(usuario.getId()).orElseThrow();
		reactivado.setActivo(true);
		usuarioRepository.save(reactivado);

		// STEP 3: Acceso ahora funciona nuevamente
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.email").value(email))
				.andExpect(jsonPath("$.activo").value(true));
	}
}
