package com.llosa.backend.seguridad.combination;

import com.llosa.backend.seguridad.entity.Usuario;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.security.core.context.SecurityContextHolder;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.securityContext;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

/**
 * CP11: Validar que un cliente con unidad "Separado" ingrese en Modo de Espera
 * (módulos bloqueados: obra, finanzas, legal)
 *
 * STRATEGY COMBINADO:
 * LAYER 1: Unit logic - verificar estado "Separado" sin BD
 * LAYER 2: Integration - verificar persistencia en BD
 * LAYER 3: E2E - validar flujo HTTP: cliente modo espera → módulos bloqueados
 */
class CP11CombinationTest extends CombinationTestBase {

	@BeforeEach
	void setUp() {
		limpiarDatos();
		SecurityContextHolder.clearContext();
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 1: Unit Logic - Verificar lógica de "Modo de Espera"
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp11_layer1_unitLogic_clienteSeparadoEnModoEspera() {
		// Escenario unitario: cliente con unidad "Separado"
		// está en "Modo de Espera" (autentica pero módulos bloqueados)

		// ARRANGE
		Usuario clienteSeparado = crearUsuarioEnBD("separado@test.com", "Cliente Separado", true);

		// ACT & ASSERT: Cliente está activo pero en "Modo de Espera"
		assertThat(clienteSeparado.getActivo()).isTrue();
		assertThat(clienteSeparado.getTipoUsuario()).isEqualTo("CLIENTE");

		// El tipo de usuario determina su modo:
		// - "Separado" = Modo de Espera (bloqueado en obra, finanzas, legal)
		// - Puede ver: Solo resumen de separación (RF-022)
		assertThat(clienteSeparado.getTipoUsuario()).isEqualTo("CLIENTE");
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 2: Integration - Verificar persistencia en BD
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp11_layer2_integration_clienteSeparadoPersistenEnBD() {
		// Escenario de integración: cliente en estado "Separado"
		// persiste correctamente en PostgreSQL

		// ARRANGE: Crear cliente en estado "Separado"
		final String email = "separado.bd@gmail.com";
		Usuario clienteSeparado = crearUsuarioConRolEnBD(email, "Cliente Separado BD", "CLIENTE", true);
		Integer clienteId = clienteSeparado.getId();

		// VERIFY
		Usuario reloaded = usuarioRepository.findById(clienteId).orElseThrow();
		assertThat(reloaded.getActivo()).isTrue(); // Autentica
		assertThat(reloaded.getTipoUsuario()).isEqualTo("CLIENTE");
		assertThat(reloaded.getRol().getNombre()).isEqualTo("CLIENTE");

		// Verificar por email
		Usuario byEmail = usuarioRepository.findByEmail(email).orElseThrow();
		assertThat(byEmail.getActivo()).isTrue();

		// ACT: Simular cambio a estado "Separado" (via tipoUsuario)
		reloaded.setTipoUsuario("CLIENTE_SEPARADO");
		usuarioRepository.save(reloaded);

		// ASSERT: Cambio persiste
		Usuario separado = usuarioRepository.findById(clienteId).orElseThrow();
		assertThat(separado.getTipoUsuario()).isEqualTo("CLIENTE_SEPARADO");
		assertThat(separado.getActivo()).isTrue(); // Sigue activo
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3: E2E - Validar flujo HTTP: cliente modo espera autenticado
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp11_layer3_e2e_clienteSeparadoModoEsperaAutenticado() throws Exception {
		// Escenario E2E: Cliente "Separado" autentica en /api/auth/me
		// pero con estado que indica "Modo de Espera"

		final String firebaseUid = "cp11-separado-uid";
		final String email = "separado@test.com";

		// SETUP: Crear cliente en "Modo de Espera" (Separado)
		Usuario cliente = crearUsuarioConRolEnBD(email, "Cliente Separado", "CLIENTE", true);
		cliente.setFirebaseUuid(firebaseUid);
		// Simular estado "Separado" via tipoUsuario
		cliente.setTipoUsuario("CLIENTE_SEPARADO");
		usuarioRepository.save(cliente);

		// VERIFY IN BD
		Usuario verified = usuarioRepository.findById(cliente.getId()).orElseThrow();
		assertThat(verified.getActivo()).isTrue();
		assertThat(verified.getTipoUsuario()).isEqualTo("CLIENTE_SEPARADO");

		// ACT: Cliente accede a /api/auth/me
		// ASSERT: Autentica (200) pero con indicador de "Modo de Espera"
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.email").value(email))
				.andExpect(jsonPath("$.activo").value(true)) // Autenticado
				.andExpect(jsonPath("$.tipoUsuario").value("CLIENTE_SEPARADO")) // Modo Espera
				.andExpect(jsonPath("$.funciones").isArray());
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3 VARIANT: E2E - Módulos bloqueados en Modo de Espera
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp11_layer3_e2e_modulosBloquedosEnModoEspera() throws Exception {
		// Escenario E2E: Cliente en Modo de Espera accede a /api/auth/me
		// pero los módulos de obra, finanzas, legal están bloqueados.
		// Solo ve resumen de separación (RF-022)

		final String firebaseUid = "cp11-modulos-bloqueados-uid";
		final String email = "espera.bloqueada@test.com";

		// SETUP: Crear cliente en Modo de Espera
		Usuario cliente = crearUsuarioConRolEnBD(email, "Cliente Espera", "CLIENTE", true);
		cliente.setFirebaseUuid(firebaseUid);
		cliente.setTipoUsuario("CLIENTE_SEPARADO");
		usuarioRepository.save(cliente);

		// ACT: Cliente obtiene su perfil
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.email").value(email))
				.andExpect(jsonPath("$.tipoUsuario").value("CLIENTE_SEPARADO")) // Indica Modo Espera
				.andExpect(jsonPath("$.funciones").isArray())
				.andExpect(jsonPath("$.funciones.length()").value(2)); // Funciones limitadas

		// EXPECTED BEHAVIOR (verificación semántica):
		// - Cliente puede VER resumen de separación (RF-022)
		// - Cliente NO puede acceder a:
		//   * Módulo de Obra (bloqueado)
		//   * Módulo de Finanzas (bloqueado)
		//   * Módulo Legal (bloqueado)
		// - El frontend debe renderizar Dashboard con mensajes de "Modo de Espera"
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3 VARIANT: E2E - Transición: Separado → Vendido (salida Modo Espera)
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp11_layer3_e2e_transicionSeparadoAVendido() throws Exception {
		// Escenario E2E: Cliente en "Modo de Espera" (Separado) →
		// su unidad pasa a "Vendido" → módulos se desbloquean

		final String firebaseUid = "cp11-transicion-uid";
		final String email = "transicion@test.com";

		// SETUP: Cliente inicialmente en Modo de Espera
		Usuario cliente = crearUsuarioConRolEnBD(email, "Cliente Transición", "CLIENTE", true);
		cliente.setFirebaseUuid(firebaseUid);
		cliente.setTipoUsuario("CLIENTE_SEPARADO");
		usuarioRepository.save(cliente);

		// STEP 1: Verificar estado inicial → Modo Espera
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.tipoUsuario").value("CLIENTE_SEPARADO"));

		// STEP 2: Cambiar estado a "Vendido" (unidad vendida)
		Usuario clienteParaActualizar = usuarioRepository.findById(cliente.getId()).orElseThrow();
		clienteParaActualizar.setTipoUsuario("CLIENTE");
		usuarioRepository.save(clienteParaActualizar);

		// Verificar cambio en BD
		Usuario clienteActualizado = usuarioRepository.findById(cliente.getId()).orElseThrow();
		assertThat(clienteActualizado.getTipoUsuario()).isEqualTo("CLIENTE");

		// STEP 3: Verificar que módulos ahora están disponibles
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.tipoUsuario").value("CLIENTE")) // Salió del Modo Espera
				.andExpect(jsonPath("$.activo").value(true));
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 2 VARIANT: Integration - Consulta de clientes en Modo Espera
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp11_layer2_integration_consultaClientesModoEspera() {
		// Escenario de integración: validar que se puede identificar
		// clientes en Modo de Espera (Separado)

		// ARRANGE: Crear mezcla de clientes
		Usuario clienteVendido = crearUsuarioConRolEnBD("vendido@test.com", "Vendido", "CLIENTE", true);
		clienteVendido.setTipoUsuario("CLIENTE");
		usuarioRepository.save(clienteVendido);

		Usuario clienteSeparado = crearUsuarioConRolEnBD("separado1@test.com", "Separado 1", "CLIENTE", true);
		clienteSeparado.setTipoUsuario("CLIENTE_SEPARADO");
		usuarioRepository.save(clienteSeparado);

		Usuario clienteSeparado2 = crearUsuarioConRolEnBD("separado2@test.com", "Separado 2", "CLIENTE", true);
		clienteSeparado2.setTipoUsuario("CLIENTE_SEPARADO");
		usuarioRepository.save(clienteSeparado2);

		// ACT & ASSERT
		assertThat(usuarioRepository.count()).isEqualTo(3);

		// Verificar cliente Vendido
		Usuario vendido = usuarioRepository.findByEmail("vendido@test.com").orElseThrow();
		assertThat(vendido.getTipoUsuario()).isEqualTo("CLIENTE");
		assertThat(vendido.getActivo()).isTrue();

		// Verificar clientes Separado
		Usuario separado1 = usuarioRepository.findByEmail("separado1@test.com").orElseThrow();
		assertThat(separado1.getTipoUsuario()).isEqualTo("CLIENTE_SEPARADO");
		assertThat(separado1.getActivo()).isTrue();

		Usuario separado2 = usuarioRepository.findByEmail("separado2@test.com").orElseThrow();
		assertThat(separado2.getTipoUsuario()).isEqualTo("CLIENTE_SEPARADO");
		assertThat(separado2.getActivo()).isTrue();
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3 VARIANT: E2E - Cliente Separado + Inactivo = Acceso completamente denegado
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp11_layer3_e2e_clienteSeparadoEInactivo() throws Exception {
		// Escenario E2E: Cliente en Modo de Espera (Separado) Y desactivado
		// → Acceso completamente denegado (más restrictivo que solo Separado)

		final String firebaseUid = "cp11-separado-inactivo-uid";
		final String email = "separado.inactivo@test.com";

		// SETUP: Cliente Separado + Inactivo
		Usuario cliente = crearUsuarioConRolEnBD(email, "Separado Inactivo", "CLIENTE", false);
		cliente.setFirebaseUuid(firebaseUid);
		cliente.setTipoUsuario("CLIENTE_SEPARADO");
		usuarioRepository.save(cliente);

		// ACT: Intentar acceder
		// ASSERT: Rechazado (403) - Inactivo toma precedencia
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isForbidden())
				.andExpect(jsonPath("$.error").value("Cuenta suspendida. Contacte a la inmobiliaria."));
	}
}
