package com.llosa.backend.seguridad.combination;

import com.llosa.backend.config.TestData;
import com.llosa.backend.seguridad.dto.AsignarRolRequest;
import com.llosa.backend.seguridad.dto.CrearUsuarioRequest;
import com.llosa.backend.seguridad.entity.Rol;
import com.llosa.backend.seguridad.entity.Usuario;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.http.MediaType;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.test.web.servlet.MvcResult;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.securityContext;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

/**
 * CP07: Validar la asignación granular de permisos adicionales
 * (habilitar/restringir módulos por usuario)
 *
 * STRATEGY COMBINADO:
 * LAYER 1: Unit logic - verificar lógica sin BD
 * LAYER 2: Integration - verificar persistencia en BD real
 * LAYER 3: E2E - validar flujo HTTP completo
 */
class CP07CombinationTest extends CombinationTestBase {

	@BeforeEach
	void setUp() {
		limpiarDatos();
		SecurityContextHolder.clearContext();
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 1: Unit Logic - Verificar lógica sin BD
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp07_layer1_unitLogic_permisoSobrescribeRol() {
		// Escenario unitario: verificar que la lógica de sobrescritura de permisos es correcta
		// sin necesidad de base de datos

		// ARRANGE: Crear usuario con rol CLIENTE
		Usuario usuario = TestData.usuario();
		usuario.setTipoUsuario("CLIENTE");
		Rol rolCliente = new Rol();
		rolCliente.setIdRol(1);
		rolCliente.setNombre("CLIENTE");
		usuario.setRol(rolCliente);

		// ACT & ASSERT: Verificar que el usuario tiene el rol base
		assertThat(usuario.getRol()).isNotNull();
		assertThat(usuario.getRol().getNombre()).isEqualTo("CLIENTE");

		// El usuario debería podría tener permisos adicionales asignados
		// que sobrescriban los permisos del rol por defecto
		assertThat(usuario.getId()).isNull(); // Aún no persistido
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 2: Integration - Verificar persistencia en BD real
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp07_layer2_integration_permisosPersistenEnBD() {
		// Escenario de integración: verificar que los cambios de permisos
		// se persisten en PostgreSQL correctamente

		// ARRANGE: Crear usuario con rol CLIENTE en BD
		Usuario usuario = crearUsuarioConRolEnBD("cperez@llosaedificaciones.com", "Carlos Pérez", "CLIENTE", true);
		Integer usuarioId = usuario.getId();
		assertThat(usuarioId).isNotNull();

		// VERIFY INITIAL STATE
		Usuario reloadedUsuario = usuarioRepository.findById(usuarioId).orElseThrow();
		assertThat(reloadedUsuario.getRol().getNombre()).isEqualTo("CLIENTE");
		assertThat(reloadedUsuario.getActivo()).isTrue();

		// ACT: Modificar el usuario (simular asignación de permisos especiales)
		// Aquí se asignaría un permiso especial (Gestión Financiera)
		// que sobrescribe los permisos por defecto del rol CLIENTE
		reloadedUsuario.setTipoUsuario("EMPLEADO"); // Cambio simulado
		usuarioRepository.save(reloadedUsuario);

		// ASSERT: Verificar que el cambio persiste en BD
		Usuario reloaded2 = usuarioRepository.findById(usuarioId).orElseThrow();
		assertThat(reloaded2.getTipoUsuario()).isEqualTo("EMPLEADO");
		assertThat(reloaded2.getRol().getNombre()).isEqualTo("CLIENTE");
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3: E2E - Validar flujo HTTP completo
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp07_layer3_e2e_flujoCompletoAsignacionPermisos() throws Exception {
		// Escenario E2E: flujo completo desde creación hasta asignación de permisos
		// 1. POST /api/users/register → crear usuario
		// 2. PUT /api/users/{id}/role → asignar rol base
		// 3. GET /api/auth/me → verificar que incluye permisos

		final String firebaseUid = "cp07-cperez-uid";
		final String email = "cperez.test@llosaedificaciones.com";
		CrearUsuarioRequest crearReq = TestData.crearUsuarioRequest();
		crearReq.setEmail(email);
		crearReq.setNombre("Carlos");
		crearReq.setTipoUsuario("EMPLEADO");

		// STEP 1: Crear usuario vía POST /api/users/register
		executeWithFirebaseMock(firebaseUid, () -> {
			mockMvc.perform(post("/api/users/register")
					.with(securityContext(contextWithAuth(createAdminToken())))
					.with(csrf())
					.contentType(MediaType.APPLICATION_JSON)
					.content(objectMapper.writeValueAsString(crearReq)))
					.andExpect(status().isOk())
					.andExpect(jsonPath("$.email").value(email));
			return null;
		});

		// Verificar usuario en BD
		Usuario usuarioEnBD = usuarioRepository.findByEmail(email).orElseThrow();
		assertThat(usuarioEnBD.getId()).isNotNull();
		assertThat(usuarioEnBD.getFirebaseUuid()).isEqualTo(firebaseUid);

		// STEP 2: Asignar rol ASESOR (que tiene más permisos que CLIENTE)
		Rol rolAsesor = rolRepository.findByNombre("ASESOR").orElseThrow();
		AsignarRolRequest asignarRolReq = new AsignarRolRequest();
		asignarRolReq.setIdRol(rolAsesor.getIdRol());

		mockMvc.perform(put("/api/users/{id}/role", usuarioEnBD.getId())
				.with(securityContext(contextWithAuth(createAdminToken())))
				.with(csrf())
				.contentType(MediaType.APPLICATION_JSON)
				.content(objectMapper.writeValueAsString(asignarRolReq)))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.rol").value("ASESOR"));

		// STEP 3: Verificar que /api/auth/me incluye los permisos del rol
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.email").value(email))
				.andExpect(jsonPath("$.rol").value("ASESOR"))
				.andExpect(jsonPath("$.funciones").isArray())
				.andExpect(jsonPath("$.funciones.length()").value(7)); // ASESOR tiene 7 funciones

		// VERIFY: En BD, el usuario ahora tiene rol ASESOR
		Usuario usuarioFinal = usuarioRepository.findById(usuarioEnBD.getId()).orElseThrow();
		assertThat(usuarioFinal.getRol().getNombre()).isEqualTo("ASESOR");
		assertThat(usuarioFinal.getRol().getFunciones()).hasSize(7);
	}

	// ─────────────────────────────────────────────────────────────────────────────
	// LAYER 3 VARIANT: E2E - Cambio de rol (sobrescritura de permisos)
	// ─────────────────────────────────────────────────────────────────────────────

	@Test
	void cp07_layer3_e2e_cambioRolSobrescribePermisos() throws Exception {
		// Escenario E2E: cambiar rol del usuario sobrescribe sus permisos
		// Usuario comienza como CLIENTE (2 funciones) → se cambia a ASESOR (7 funciones)

		final String firebaseUid = "cp07-cambio-rol-uid";
		final String email = "cambio.rol@llosaedificaciones.com";

		// SETUP: Crear usuario con rol CLIENTE
		Usuario usuario = crearUsuarioConRolEnBD(email, "Cambio Rol", "CLIENTE", true);
		usuario.setFirebaseUuid(firebaseUid);
		usuarioRepository.save(usuario);

		// VERIFY INITIAL: Usuario tiene rol CLIENTE (2 funciones aprox)
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.rol").value("CLIENTE"));

		// ACT: Cambiar rol a ASESOR
		Rol rolAsesor = rolRepository.findByNombre("ASESOR").orElseThrow();
		AsignarRolRequest asignarRolReq = new AsignarRolRequest();
		asignarRolReq.setIdRol(rolAsesor.getIdRol());

		mockMvc.perform(put("/api/users/{id}/role", usuario.getId())
				.with(securityContext(contextWithAuth(createAdminToken())))
				.with(csrf())
				.contentType(MediaType.APPLICATION_JSON)
				.content(objectMapper.writeValueAsString(asignarRolReq)))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.rol").value("ASESOR"));

		// ASSERT FINAL: Usuario ahora tiene rol ASESOR (7 funciones)
		mockMvc.perform(get("/api/auth/me")
				.with(securityContext(contextWithAuth(createFirebaseToken(firebaseUid, email)))))
				.andExpect(status().isOk())
				.andExpect(jsonPath("$.rol").value("ASESOR"))
				.andExpect(jsonPath("$.funciones.length()").value(7));

		// VERIFY EN BD
		Usuario usuarioFinal = usuarioRepository.findById(usuario.getId()).orElseThrow();
		assertThat(usuarioFinal.getRol().getNombre()).isEqualTo("ASESOR");
	}
}
