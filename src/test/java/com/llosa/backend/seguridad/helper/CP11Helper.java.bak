package com.llosa.backend.seguridad.helper;

import com.llosa.backend.seguridad.entity.Rol;
import com.llosa.backend.seguridad.entity.Usuario;
import com.llosa.backend.seguridad.repository.RolRepository;
import com.llosa.backend.seguridad.repository.UsuarioRepository;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.Optional;

/**
 * Helper para tests de CP11: Modo de Espera (Unidad Separado)
 *
 * Proporciona utilidades para:
 * - Activar modo de espera para un cliente
 * - Verificar bloqueo de módulos (obra, finanzas, legal)
 * - Validar que solo resumen de separación es visible
 * - Gestionar transición de estados de unidad
 *
 * @author Engineer BDD
 * @version 1.0
 */
@Component
public class CP11Helper {

    private final UsuarioRepository usuarioRepository;
    private final RolRepository rolRepository;

    public CP11Helper(UsuarioRepository usuarioRepository,
                      RolRepository rolRepository) {
        this.usuarioRepository = usuarioRepository;
        this.rolRepository = rolRepository;
    }

    /**
     * Verifica que un usuario está en modo de espera.
     * En CP11, esto significa que la unidad está en estado "Separado".
     *
     * @param usuarioId ID del usuario
     * @return true si usuario debe estar en modo de espera
     */
    public boolean enModoEspera(long usuarioId) {
        Optional<Usuario> usuario = usuarioRepository.findById(usuarioId);
        if (usuario.isEmpty()) {
            return false;
        }

        Usuario u = usuario.get();
        // En contexto de CP11, verificar que usuario está activo
        // La lógica de "Separado" pertenece a módulo de Activos
        return u.getActivo();
    }

    /**
     * Obtiene las funciones disponibles para un usuario en modo espera.
     * En modo espera, solo debería tener acceso de lectura limitada.
     *
     * @param usuarioId ID del usuario
     * @return Lista de nombres de funciones permitidas
     */
    public List<String> obtenerFuncionesEnModoEspera(long usuarioId) {
        Optional<Usuario> usuario = usuarioRepository.findById(usuarioId);
        if (usuario.isEmpty()) {
            return List.of();
        }

        Usuario u = usuario.get();
        if (u.getRol() == null || u.getRol().getFunciones() == null) {
            return List.of();
        }

        // En modo espera, filtrar solo funciones de lectura y separación
        return u.getRol().getFunciones().stream()
                .map(f -> f.getNombreCodigo())
                .filter(cod -> !cod.contains("EDITAR") && !cod.contains("CREAR") &&
                               !cod.contains("ELIMINAR"))
                .toList();
    }

    /**
     * Verifica que módulos críticos están bloqueados en modo espera.
     * Módulos bloqueados: OBRA, FINANZAS, LEGAL
     *
     * @param usuarioId ID del usuario
     * @return true si módulos críticos están bloqueados
     */
    public boolean modulos_CriticosEstanBloqueados(long usuarioId) {
        List<String> funciones = obtenerFuncionesEnModoEspera(usuarioId);

        boolean tieneOBRA = funciones.stream().anyMatch(f -> f.contains("OBRA"));
        boolean tieneFINANZA = funciones.stream().anyMatch(f -> f.contains("FINANZA") || f.contains("PAGO"));
        boolean tieneLEGAL = funciones.stream().anyMatch(f -> f.contains("LEGAL") || f.contains("DOCS"));

        // Todos deben estar bloqueados (false)
        return !tieneOBRA && !tieneFINANZA && !tieneLEGAL;
    }

    /**
     * Verifica que el usuario tiene acceso de lectura a resumen de separación.
     * Ref: RF-022 (Resumen Separación)
     *
     * @param usuarioId ID del usuario
     * @return true si usuario puede leer resumen de separación
     */
    public boolean puedeVerResumenSeparacion(long usuarioId) {
        List<String> funciones = obtenerFuncionesEnModoEspera(usuarioId);
        // Buscar función de lectura general (no bloqueada)
        return !funciones.isEmpty();
    }

    /**
     * Cuenta funciones disponibles en modo espera.
     * Útil para validar que solo funciones permitidas están disponibles.
     *
     * @param usuarioId ID del usuario
     * @return Número de funciones en modo espera
     */
    public int contarFuncionesEnModoEspera(long usuarioId) {
        return obtenerFuncionesEnModoEspera(usuarioId).size();
    }

    /**
     * Obtiene el rol de cliente estándar.
     * En CP11, cliente con unidad Separado sigue teniendo rol CLIENTE.
     *
     * @return Rol CLIENTE
     */
    public Optional<Rol> obtenerRolCliente() {
        return rolRepository.findByNombre("CLIENTE");
    }

    /**
     * Valida el flujo completo de CP11:
     * 1. Usuario autenticado (activo=true)
     * 2. Rol asignado (CLIENTE)
     * 3. Módulos críticos bloqueados
     * 4. Acceso a resumen de separación
     *
     * @param usuarioId ID del usuario
     * @return true si flujo completo es válido
     */
    public boolean validarFlujoCP11Completo(long usuarioId) {
        try {
            Optional<Usuario> usuario = usuarioRepository.findById(usuarioId);
            if (usuario.isEmpty()) {
                return false;
            }

            Usuario u = usuario.get();

            // 1. Debe estar autenticado (activo)
            if (!u.getActivo()) {
                return false;
            }

            // 2. Debe tener rol (idealmente CLIENTE)
            if (u.getRol() == null) {
                return false;
            }

            // 3. Debe tener funciones (aunque bloqueadas)
            List<String> funciones = obtenerFuncionesEnModoEspera(usuarioId);
            if (funciones.isEmpty()) {
                return false;
            }

            // 4. Módulos críticos deben estar bloqueados
            if (!modulos_CriticosEstanBloqueados(usuarioId)) {
                return false;
            }

            // 5. Acceso a resumen de separación habilitado
            return puedeVerResumenSeparacion(usuarioId);
        } catch (Exception e) {
            return false;
        }
    }

    /**
     * Obtiene diagnóstico detallado del estado de un usuario en CP11.
     * Útil para debugging de fallos.
     *
     * @param usuarioId ID del usuario
     * @return String con diagnóstico
     */
    public String obtenerDiagnostico(long usuarioId) {
        StringBuilder sb = new StringBuilder();
        sb.append("=== DIAGNÓSTICO CP11 ===\n");

        Optional<Usuario> usuario = usuarioRepository.findById(usuarioId);
        if (usuario.isEmpty()) {
            sb.append("ERROR: Usuario no encontrado\n");
            return sb.toString();
        }

        Usuario u = usuario.get();
        sb.append("Usuario: ").append(u.getEmail()).append("\n");
        sb.append("Activo: ").append(u.getActivo()).append("\n");
        sb.append("Rol: ").append(u.getRol() != null ? u.getRol().getNombre() : "SIN ROL").append("\n");

        List<String> funciones = obtenerFuncionesEnModoEspera(usuarioId);
        sb.append("Funciones (lectura): ").append(funciones).append("\n");
        sb.append("Total funciones: ").append(funciones.size()).append("\n");

        sb.append("Módulos críticos bloqueados: ").append(modulos_CriticosEstanBloqueados(usuarioId)).append("\n");
        sb.append("Acceso resumen separación: ").append(puedeVerResumenSeparacion(usuarioId)).append("\n");

        sb.append("Validación CP11: ").append(validarFlujoCP11Completo(usuarioId) ? "✅ PASS" : "❌ FAIL").append("\n");

        return sb.toString();
    }
}
